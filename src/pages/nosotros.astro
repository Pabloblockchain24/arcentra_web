---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Nosotros | Arcentra">

  <!-- HERO + DATA -->
  <section class="hero">
    <div class="overlay"></div>

    <div class="container hero-grid">

      <!-- TEXTO -->
      <div class="hero-content">
        <h1>Logística a tu medida</h1>
                <!-- 🔥 PROPUESTA DE VALOR -->
        <div class="value-box">
          <p>
            Centralizamos tu operación logística —desde el retiro de contenedores hasta la entrega final— eliminando sobrecostos, mejorando eficiencia operativa y garantizando control total de la carga en cada etapa.
          </p>
        </div>

      </div>

      <!-- MÉTRICAS -->
      <div class="hero-stats">
        <div class="stat">
          <span>32+</span>
          <p>Años de experiencia</p>
        </div>

        <div class="stat">
          <span>20+</span>
          <p>Camiones operativos</p>
        </div>

        <div class="stat">
          <span>10.000+ m²</span>
          <p>Capacidad</p>
        </div>

        <div class="stat">
          <span>24/7</span>
          <p>Control</p>
        </div>
      </div>

    </div>
  </section>

  <!-- BLOQUE VISUAL -->
  <section class="split">
  <div class="container split-grid">
    <div class="gallery">
      <div class="main-image">
        <img
          src="/entregas.jpeg"
          alt="Operación logística Arcentra"
        />

        <div class="floating-card">
          <span>32+</span>
          <p>Años movilizando cargas a lo largo de todo Chile</p>
        </div>

      </div>

      <div class="side-images">

        <img
          src="/Reefer.png"
          alt="Transporte de carga"
        />

        <img
          src="/vacios.jpg"
          alt="Operación logística"
        />

      </div>

    </div>

    <div class="text">

      <span class="tag">
        NOSOTROS
      </span>

      <h2>
        Nos integramos a tu operación logística
      </h2>

      <p>
        No solo transportamos carga. Nos convertimos en una extensión de tu
        operación para asegurar continuidad, trazabilidad y cumplimiento
        desde el puerto hasta la entrega final.
      </p>

      <p>
        Coordinamos recursos, anticipamos contingencias y ejecutamos con
        estándares que permiten a nuestros clientes enfocarse en hacer crecer
        su negocio.
      </p>

      <div class="features">

        <div class="feature">
          ✓ Control operacional
        </div>

        <div class="feature">
          ✓ Trazabilidad completa
        </div>

        <div class="feature">
          ✓ Capacidad escalable
        </div>

        <div class="feature">
          ✓ Respuesta rápida
        </div>

      </div>

      <a href="/#cotizar" class="cta">
        Solicitar cotización
      </a>

    </div>

  </div>
</section>

</MainLayout>

<style>
.container {
  max-width: 1100px;
  margin: auto;
  padding: 3rem 1rem;
  font-family: 'Montserrat', sans-serif;
}

/* HERO */
.hero {
  position: relative;
  padding: 8rem 2rem;
  background: url("/hero.png") center/cover no-repeat;
  color: white;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
}

.hero-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 50px;
  align-items: center;
}
.hero-content {
  width: 90%;
}

/* TEXT */
.hero-content h1 {
  font-size: 2rem;
  margin-bottom: 1.5rem;
}

.intro {
  color: #d1d5db;
  margin-bottom: 25px;
  max-width: 500px;
}

/* 🔥 VALUE BOX (ESTO ES LO IMPORTANTE) */
.value-box {
  background: rgba(250, 204, 21, 0.1);
  border: 1px solid rgba(250, 204, 21, 0.4);
  padding: 20px;
  border-radius: 10px;
  max-width: 520px;
  backdrop-filter: blur(6px);
  position: relative;
}

/* línea lateral corporativa */
.value-box::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 4px;
  background: #facc15;
  border-radius: 2px;
}

.value-box p {
  margin: 0;
  color: #f9fafb;
  font-size: 0.85rem;
  line-height: 1.6;
 
}

/* CTA */
.cta {
  background: #facc15;
  color: black;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  font-weight: bold;
  border-radius: 6px;
  font-size: 0.9rem;
}

/* STATS */
.hero-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.stat {
  background: rgba(255,255,255,0.05);
  padding: 1.5rem;
  border-radius: 10px;
  text-align: center;
  backdrop-filter: blur(6px);
}

.stat span {
  font-size: 1.5rem;
  color: #facc15;
  font-weight: bold;
}

.stat p {
  font-size: 0.9rem;
  color: #cbd5f5;
}

/* SPLIT */
.split {
  padding: 2rem 1rem;
  background: #fafafa;
}

.split-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 5rem;
  align-items: start;
}

/* GALERÍA */

.gallery {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 1rem;
}

.main-image {
  position: relative;
}

.main-image img,
.side-images img {
  width: 100%;
  display: block;
  object-fit: cover;
  border-radius: 6px;
}

.main-image img {
  height: 560px;
}

.side-images {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 18px;
}

.side-images img {
  height: 271px;
}

/* TARJETA */

.floating-card {
  position: absolute;
  left: 30px;
  right: 10px;
  bottom: 20px;
  background: white;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  box-shadow:
    0 10px 25px rgba(0,0,0,.5);
}

.floating-card span {
  display: block;
  font-size: 1.5rem;
  font-weight: 700;
  color: #f7c708;
}

.floating-card p {
  margin-top: 5px;
  font-size: .8rem;
  color: #000000;
}

/* TEXTO */

.tag {
  display: inline-block;
  margin-bottom: 1rem;
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: 2px;
  color: #facc15;
}

.text h2 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.text p {
  color: #555;
  line-height: 1.5;
  margin-bottom: 1rem;
  font-size: .9rem;
}

/* BENEFICIOS */

.features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.feature {
  background: rgb(228, 228, 228);
  padding: 14px;
  border-radius: 10px;
  font-size: .85rem;
  font-weight: 600;
  box-shadow:
    0 3px 12px rgba(0,0,0,.05);
}

/* CTA */

.text .cta {
  display: inline-block;
  margin-top: 2rem;
}

/* =========================
   ≤ 1200px
========================= */
@media (max-width: 1200px) {
  .hero {
    padding: 8rem 4rem;
  }
  .hero-content {
    width: 85%;
  }

  .hero-grid {
    gap: 20px;
  }

  .hero-content h1 {
    font-size: 1.7rem;
  }

   .split-grid {
    gap: 3rem;
  }

  .text h2 {
    font-size: 2rem;
  }

  .main-image img {
    height: 500px;
  }

  .side-images img {
    height: 241px;
  }

  .stat{
    padding: 1.25rem;
  }

.stat span {
  font-size: 1.4rem;

}

.stat p {
  font-size: 0.75rem;
}


}

/* =========================
   ≤ 992px
========================= */
@media (max-width: 992px) {
  .hero {
    padding: 8rem 2rem;
  }

  .hero-grid {
    gap: 35px;
  }

  .hero-content h1 {
    font-size: 1.5rem;
  }

  .value-box {
    max-width: 100%;
    padding: 18px;
  }

  .value-box p {
    font-size: 0.8rem;
  }

  .stat {
    padding: 18px;
  }

  .stat span {
    font-size: 1.2rem;
  }

  .stat p {
    font-size: 0.8rem;
  }

   .split-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .gallery {
    max-width: 800px;
    margin: auto;
  }

  .text {
    text-align: center;
  }

  .features {
    max-width: 700px;
    margin: 2rem auto 0;
  }

  .text .cta {
    margin-top: 2rem;
  }

  .text h2 {
    font-size: 1.5rem;
  }
}

/* =========================
   ≤ 768px
========================= */
@media (max-width: 768px) {
  .hero-content{
    width: 100%;
  }

  .hero {
    padding: 6rem 2rem 5rem;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .hero-content {
    text-align: center;
  }

  .hero-content h1 {
    font-size: 2rem;
  }

  .value-box {
    margin: 0 auto;
  }

  .hero-stats {
    grid-template-columns: 1fr 1fr;
  }

   .split {
    padding: 5rem 1.5rem;
  }

  .gallery {
    grid-template-columns: 1fr;
  }

  .side-images {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }

  .main-image img {
    height: 420px;
  }

  .side-images img {
    height: 220px;
  }

  .text h2 {
    font-size: 1.8rem;
  }

  .features {
    grid-template-columns: 1fr;
  }
}

/* =========================
   ≤ 576px
========================= */
@media (max-width: 576px) {
  .container {
    padding: 2rem 0;
    width: 85%;

  }

  .hero {
    padding: 100px 0 70px;
  }

  .hero-content h1 {
    font-size: 1.4rem;
  }

  .value-box {
    padding: 16px;
  }

  .value-box::before {
    width: 3px;
  }

  .value-box p {
    font-size: 0.8rem;
    line-hight: 1.6;
  }

  .hero-stats {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .stat {
    padding: 0.5rem;
  }

  .stat span {
    font-size: 1.1rem;
  }

  .stat p {
    font-size: 0.75rem;
  }

  .split {
    padding: 4rem 1rem;
  }

  .main-image img {
    height: 320px;
  }

  .side-images {
    grid-template-columns: 1fr;
  }

  .side-images img {
    height: 180px;
  }

  .floating-card {
    left: 12px;
    right: 12px;
    bottom: 12px;
  }

  .floating-card span {
    font-size: 1.5rem;
  }

  .text h2 {
    font-size: 1.5rem;
  }

  .text p {
    font-size: .95rem;
  }

  .feature {
    text-align: left;
  }

  .text .cta {
    width: 100%;
    text-align: center;
  }
}
</style>