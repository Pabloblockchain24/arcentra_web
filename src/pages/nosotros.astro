---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Nosotros | Arcentra">

  <!-- HERO + DATA -->
  <section class="hero">
    <div class="overlay"></div>

    <div class="container hero-grid">

      <!-- TEXTO -->
      <div class="hero-content">
        <h1>Logística que no falla</h1>


                <!-- 🔥 PROPUESTA DE VALOR -->
        <div class="value-box">
          <p>
            Centralizamos la operación logística en puerto —desde el retiro de contenedores hasta la entrega final— eliminando sobrecostos, mejorando eficiencia operativa y garantizando control total de la carga en cada etapa.
          </p>
        </div>

      </div>

      <!-- MÉTRICAS -->
      <div class="hero-stats">
        <div class="stat">
          <span>32+</span>
          <p>Años de experiencia</p>
        </div>

        <div class="stat">
          <span>20+</span>
          <p>Camiones operativos</p>
        </div>

        <div class="stat">
          <span>10.000 m²</span>
          <p>Capacidad</p>
        </div>

        <div class="stat">
          <span>24/7</span>
          <p>Monitoreo</p>
        </div>
      </div>

    </div>
  </section>

  <!-- BLOQUE VISUAL -->
  <section class="split">
    <div class="container split-grid">

      <div class="image">
        <img src="/entregas.jpeg" alt="operación arcentra">
      </div>

      <div class="text">
        <h2>Nos integramos a tu operación</h2>

        <p>
          No solo transportamos carga. Nos involucramos en la operación completa
          para asegurar continuidad, visibilidad y cumplimiento en cada etapa.
        </p>

        <p>
          Anticipamos problemas, optimizamos tiempos y ejecutamos con estándar
          profesional en terreno.
        </p>

        <a href="/#cotizar" class="cta">Solicitar cotización</a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
.container {
  max-width: 1100px;
  margin: auto;
  padding: 0 20px;
  font-family: 'Montserrat', sans-serif;
}

/* HERO */
.hero {
  position: relative;
  padding: 140px 20px;
  background: url("/hero.png") center/cover no-repeat;
  color: white;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
}

.hero-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 50px;
  align-items: center;
}

/* TEXT */
.hero-content h1 {
  font-size: 2.8rem;
  margin-bottom: 25px;
}

.intro {
  color: #d1d5db;
  margin-bottom: 25px;
  max-width: 500px;
}

/* 🔥 VALUE BOX (ESTO ES LO IMPORTANTE) */
.value-box {
  background: rgba(250, 204, 21, 0.1);
  border: 1px solid rgba(250, 204, 21, 0.4);
  padding: 20px;
  border-radius: 10px;
  max-width: 520px;

  backdrop-filter: blur(6px);

  position: relative;
}

/* línea lateral corporativa */
.value-box::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 4px;
  background: #facc15;
  border-radius: 2px;
}

.value-box p {
  margin: 0;
  color: #f9fafb;
  font-size: 0.95rem;
  line-height: 1.6;
}

/* CTA */
.cta {
  background: #facc15;
  color: black;
  padding: 12px 22px;
  text-decoration: none;
  font-weight: bold;
  border-radius: 6px;
}

/* STATS */
.hero-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.stat {
  background: rgba(255,255,255,0.05);
  padding: 20px;
  border-radius: 10px;
  text-align: center;
  backdrop-filter: blur(6px);
}

.stat span {
  font-size: 1.8rem;
  color: #facc15;
  font-weight: bold;
}

.stat p {
  font-size: 0.9rem;
  color: #cbd5f5;
}

/* SPLIT */
.split {
  padding: 100px 20px;

  a{
    display: inline-block;
    margin-top: 20px;
  }
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.image img {
  width: 100%;
  border-radius: 12px;
}

.text h2 {
  margin-bottom: 20px;
  font-size: 1.8rem;
}

.text p {
  margin-bottom: 15px;
  color: #555;
}

/* MOBILE */
@media (max-width: 768px) {

  .hero {
    padding: 120px 20px 80px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-content h1 {
    font-size: 2rem;
  }

  .hero-stats {
    grid-template-columns: 1fr 1fr;
  }

  .value-box {
    font-size: 0.9rem;
  }

  .split-grid {
    grid-template-columns: 1fr;
  }
}
</style>