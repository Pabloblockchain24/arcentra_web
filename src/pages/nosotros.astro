---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Nosotros | Arcentra">

  <!-- HERO + DATA -->
  <section class="hero">
    <div class="overlay"></div>

    <div class="container hero-grid">

      <!-- TEXTO -->
      <div class="hero-content">
        <h1>Logística a tu medida</h1>
                <!-- 🔥 PROPUESTA DE VALOR -->
        <div class="value-box">
          <p>
            Centralizamos tu operación logística —desde el retiro de contenedores hasta la entrega final— eliminando sobrecostos, mejorando eficiencia operativa y garantizando control total de la carga en cada etapa.
          </p>
        </div>

      </div>

      <!-- MÉTRICAS -->
      <div class="hero-stats">
        <div class="stat">
          <span>32+</span>
          <p>Años de experiencia</p>
        </div>

        <div class="stat">
          <span>20+</span>
          <p>Camiones operativos</p>
        </div>

        <div class="stat">
          <span>10.000+ m²</span>
          <p>Capacidad</p>
        </div>

        <div class="stat">
          <span>24/7</span>
          <p>Control</p>
        </div>
      </div>

    </div>
  </section>

  <!-- BLOQUE VISUAL -->
  <section class="split">
    <div class="container split-grid">

      <div class="image">
        <img src="/entregas.jpeg" alt="operación arcentra">
      </div>

      <div class="text">
        <h2>Nos integramos a tu operación</h2>

        <p>
          No solo transportamos carga. Nos involucramos en la operación completa
          para asegurar continuidad, visibilidad y cumplimiento en cada etapa.
        </p>

        <p>
          Anticipamos problemas, optimizamos tiempos y ejecutamos con estándar
          profesional en terreno.
        </p>

        <a href="/#cotizar" class="cta">Solicitar cotización</a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
.container {
  max-width: 1100px;
  margin: auto;
  padding: 3rem 1rem;
  font-family: 'Montserrat', sans-serif;
}

/* HERO */
.hero {
  position: relative;
  padding: 8rem 2rem;
  background: url("/hero.png") center/cover no-repeat;
  color: white;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
}

.hero-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 50px;
  align-items: center;
}
.hero-content {
  width: 90%;
}

/* TEXT */
.hero-content h1 {
  font-size: 2rem;
  margin-bottom: 1.5rem;
}

.intro {
  color: #d1d5db;
  margin-bottom: 25px;
  max-width: 500px;
}

/* 🔥 VALUE BOX (ESTO ES LO IMPORTANTE) */
.value-box {
  background: rgba(250, 204, 21, 0.1);
  border: 1px solid rgba(250, 204, 21, 0.4);
  padding: 20px;
  border-radius: 10px;
  max-width: 520px;
  backdrop-filter: blur(6px);
  position: relative;
}

/* línea lateral corporativa */
.value-box::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 4px;
  background: #facc15;
  border-radius: 2px;
}

.value-box p {
  margin: 0;
  color: #f9fafb;
  font-size: 0.85rem;
  line-height: 1.6;
 
}

/* CTA */
.cta {
  background: #facc15;
  color: black;
  padding: 12px 22px;
  text-decoration: none;
  font-weight: bold;
  border-radius: 6px;
}

/* STATS */
.hero-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.stat {
  background: rgba(255,255,255,0.05);
  padding: 1.5rem;
  border-radius: 10px;
  text-align: center;
  backdrop-filter: blur(6px);
}

.stat span {
  font-size: 1.5rem;
  color: #facc15;
  font-weight: bold;
}

.stat p {
  font-size: 0.9rem;
  color: #cbd5f5;
}

/* SPLIT */
.split {
  padding: 100px 20px;

  a{
    display: inline-block;
    margin-top: 20px;
  }
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.image img {
  width: 100%;
  border-radius: 12px;
}

.text h2 {
  margin-bottom: 20px;
  font-size: 1.8rem;
}

.text p {
  margin-bottom: 15px;
  color: #555;
}

/* =========================
   ≤ 1200px
========================= */
@media (max-width: 1200px) {
  .hero {
    padding: 8rem 4rem;
  }
  .hero-content {
    width: 85%;
  }

  .hero-grid {
    gap: 20px;
  }

  .hero-content h1 {
    font-size: 1.7rem;
  }

  .split {
    padding: 90px 20px;
  }

  .split-grid {
    gap: 50px;
  }

  .stat{
    padding: 1.25rem;
  }

.stat span {
  font-size: 1.4rem;

}

.stat p {
  font-size: 0.75rem;
}


}

/* =========================
   ≤ 992px
========================= */
@media (max-width: 992px) {
  .hero {
    padding: 8rem 2rem;
  }

  .hero-grid {
    gap: 35px;
  }

  .hero-content h1 {
    font-size: 1.5rem;
  }

  .value-box {
    max-width: 100%;
    padding: 18px;
  }

  .value-box p {
    font-size: 0.8rem;
  }

  .stat {
    padding: 18px;
  }

  .stat span {
    font-size: 1.2rem;
  }

  .stat p {
    font-size: 0.8rem;
  }

  .split {
    padding: 80px 20px;
  }

  .split-grid {
    gap: 40px;
  }

  .text h2 {
    font-size: 1.6rem;
  }
}

/* =========================
   ≤ 768px
========================= */
@media (max-width: 768px) {
  .hero-content{
    width: 100%;
  }

  .hero {
    padding: 6rem 2rem 5rem;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .hero-content {
    text-align: center;
  }

  .hero-content h1 {
    font-size: 2rem;
  }

  .value-box {
    margin: 0 auto;
  }

  .hero-stats {
    grid-template-columns: 1fr 1fr;
  }

  .split {
    padding: 70px 20px;
  }

  .split-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .image {
    order: 1;
  }

  .text {
    order: 2;
    text-align: center;
  }

  .text h2 {
    font-size: 1.5rem;
  }
}

/* =========================
   ≤ 576px
========================= */
@media (max-width: 576px) {
  .container {
    padding: 2rem 0;
    width: 85%;

  }

  .hero {
    padding: 100px 0 70px;
  }

  .hero-content h1 {
    font-size: 1.4rem;
  }

  .value-box {
    padding: 16px;
  }

  .value-box::before {
    width: 3px;
  }

  .value-box p {
    font-size: 0.8rem;
    line-hight: 1.6;
  }

  .hero-stats {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .stat {
    padding: 0.5rem;
  }

  .stat span {
    font-size: 1.1rem;
  }

  .stat p {
    font-size: 0.75rem;
  }

  .split {
    padding: 4rem 0;
  }

  .text h2 {
    font-size: 1.35rem;
  }

  .text p {
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .cta {
    width: 100%;
    text-align: center;
    padding: 14px;
  }
}
</style>