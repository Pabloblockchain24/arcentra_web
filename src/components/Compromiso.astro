  <div class="container">
    <div class="header">
      <h2 class="why-title">¿Por qué Arcentra?</h2>
    </div>

    <div class="why-wrapper">
      <!-- SIDEBAR -->
      <div class="sidebar">
        <div class="item active">Control total</div>
        <div class="item">Capacidad operativa</div>
        <div class="item">Experiencia</div>
        <div class="item">Atención personalizada</div>
      </div>

      <!-- PANEL -->
      <div class="content-box">
        <div class="content active">
          <div class="icon">
            <img src="/icon/map-pin-check.png" alt="location" />
          </div>
          <p>
            Sigue el estado de tu carga en tiempo real desde nuestro Portal
            Arcentra, con monitoreo GPS en cada etapa.
          </p>
        </div>

        <div class="content">
          <div class="icon">
            <img src="/icon/truck.png" alt="truck" />
          </div>

          <p>
            Flota de más de 20 camiones y depósito de más de 10.000 m² para
            responder cuando lo necesites. En 2025 hicimos +1000 operaciones
            logísticas.
          </p>
        </div>

        <div class="content">
          <div class="icon">
            <img src="/icon/shield-check.png" alt="warehouse" />
          </div>

          <p>
