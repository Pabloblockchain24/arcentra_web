    </div>
  </div>
</section>

<style>
  .why {
    padding: 1rem 0 3rem 0;
    background: white;
    font-family: "Montserrat", sans-serif;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .header h2 {
    font-size: 2rem;
  }

  /* WRAPPER */
  .why-wrapper {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: stretch;
    padding: 0 1rem;
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    border-left: 2px solid #eee;
  }

  .item {
    padding: 16px;
    cursor: pointer;
    background: transparent;
    position: relative;
    transition: all 0.25s ease;
    font-weight: 400;
  }

  /* 🔥 indicador lateral */
  .item::before {
    content: "";
    position: absolute;
    left: -2px;
    top: 0;
    height: 100%;
    width: 2px;
    background: transparent;
    transition: all 0.3s ease;
  }

  .item:hover {
    background: #f1af2052;
    font-weight: 700 !important;
  }

  .item.active {
    color: #111;
    font-weight: 600;
  }

  .item.active::before {
    background: #facc15;
    width: 4px;
  }

  /* PANEL */
  /* PANEL ULTRA CORPORATIVO */
  .content-box {
    position: relative;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 2.5rem;
    overflow: hidden;
    min-height: 200px;

    /* profundidad */
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);

    /* borde sutil premium */
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* glow dinámico */
  .content-box::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(250, 204, 21, 0.15),
      transparent 70%
    );
    top: -100px;
    right: -100px;
    pointer-events: none;
    transition: all 0.5s ease;
  }

  /* CONTENIDO */
  .content {
    position: absolute;
    inset: 0;
    padding: 2.5rem;

    opacity: 0;
    transform: translateY(20px) scale(0.97);

    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  /* ACTIVO */
  .content.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    z-index: 2;
  }

  /* ICONO PRO */
  /* contenedor */
  .icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.25);
  }

  /* 🔥 NORMALIZA TODOS LOS ICONOS */
  .icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;

    /* opcional: los deja todos amarillos */
    filter: brightness(0) saturate(100%) invert(84%) sepia(54%) saturate(600%)
      hue-rotate(350deg);
  }

  .content.active .icon {
    transform: scale(1);
    opacity: 1;
  }

  /* TEXTO */
  .content p {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 520px;
    color: #cbd5f5;

    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
  }

  .content.active p {
    opacity: 1;
    transform: translateY(0);
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .why-wrapper {
      grid-template-columns: 1fr;
    }

    .why-title {
      font-size: 1.7rem !important;
    }

    .header{
      margin-bottom: 2rem;
    }

    .content-box{
      margin-top: 0;
    }

    .sidebar {
      flex-direction: row;
      overflow-x: auto;
      border-left: none;
      border-bottom: 2px solid #eee;
    }

    .item {
      white-space: nowrap;
    }

    .item::before {
      display: none;
    }

    .content-box {
      margin-top: 20px;
    }

    .content p {
    font-size: 0.9rem;
  }


  }
</style>

<script client:load>
  const section = document.querySelector(".why");

  const items = section.querySelectorAll(".item");
  const contents = section.querySelectorAll(".content");

  function setActive(index) {
    items.forEach((el) => el.classList.remove("active"));
    contents.forEach((el) => el.classList.remove("active"));

    items[index]?.classList.add("active");
    contents[index]?.classList.add("active");
  }

  /* eventos */
  items.forEach((item, i) => {
    item.addEventListener("mouseenter", () => setActive(i));
    item.addEventListener("click", () => setActive(i));
  });

  /* INIT */
  setActive(0);
</script>
