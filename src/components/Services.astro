<style>
.services {
  padding: 80px 20px;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  font-family: "Montserrat", sans-serif;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 50px;
  
  h2{
    margin-bottom: 0.5rem;
    font-size: 1.9rem;
    color: white;
  }

  p{
    color: white
  }
}

/* SCROLL */
.carousel {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch; /* 🔥 iOS smooth */
  cursor: grab;
    touch-action: pan-x;

}

.carousel::-webkit-scrollbar {
  display: none;
}

.carousel {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.carousel:active {
  cursor: grabbing;
}

/* TRACK */
.track {
  display: flex;
  gap: 20px;
  padding: 20px;
  width: max-content; /* 🔥 importante */
}

/* CARD */
.card {
  flex: 0 0 80%;
  max-width: 320px;
  scroll-snap-align: center;
  background: white;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  opacity: 0.4;
  transform: scale(0.9);
  filter: blur(2px);
}

.card.active {
  opacity: 1;
  transform: scale(1);
  filter: blur(0);
  box-shadow: 0 25px 60px rgba(0,0,0,0.15);
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

/* CONTENT */
.content {
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.content h3 {
  font-size: 1.1rem;
  margin-bottom: 10px;
}

.content p {
  font-size: 0.9rem;
  color: #555;
  flex-grow: 1;
}

/* CTA */
.cta {
  margin-top: 25px;
  font-size: 0.9rem;
  background: #111;
  color: white;
  text-align: center;
  padding: 10px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
}

.cta:hover {
  transform: translateY(-2px);
  background: black;
}

/* DOTS */
.dots {
  display: flex;
  justify-content: center;
  margin-top: 20px;
  gap: 8px;
}

.dot {
  width: 8px;
  height: 8px;
  background: #ccc;
  border-radius: 50%;
}

.dot.active {
  width: 20px;
  background: #111;
}
</style>

<script client:load>
const slider = document.getElementById("carousel");
const track = document.getElementById("track");
const cards = track.querySelectorAll(".card");
const dotsContainer = document.getElementById("dots");

const total = cards.length / 2;
let index = 0;
let isHovering = false;

/* DRAG SCROLL (🔥 clave UX) */
let isDown = false;
let startX;
let scrollLeft;

slider.addEventListener("mousedown", (e) => {
  isDown = true;
  startX = e.pageX - slider.offsetLeft;
  scrollLeft = slider.scrollLeft;
});

slider.addEventListener("mouseleave", () => isDown = false);
slider.addEventListener("mouseup", () => isDown = false);

slider.addEventListener("mousemove", (e) => {
  if (!isDown) return;
  e.preventDefault();
  const x = e.pageX - slider.offsetLeft;
  const walk = (x - startX) * 1.5;
  slider.scrollLeft = scrollLeft - walk;
});

/* DOTS */
for (let i = 0; i < total; i++) {
  const dot = document.createElement("div");
  dot.classList.add("dot");
  dotsContainer.appendChild(dot);

  dot.onclick = () => {
    index = i;
    scrollToCard(index);
  };
}

const dots = dotsContainer.querySelectorAll(".dot");

/* SCROLL */
const scrollToCard = (i) => {
  const card = cards[i];
  const center = slider.offsetWidth / 2;
  const cardCenter = card.offsetLeft + card.offsetWidth / 2;

  slider.scrollTo({
    left: cardCenter - center,
    behavior: "smooth"
  });
};

/* UPDATE */
const update = () => {
  let closest = 0;
  let min = Infinity;

  cards.forEach((card, i) => {
    const rect = card.getBoundingClientRect();
    const offset = Math.abs(window.innerWidth / 2 - (rect.left + rect.width / 2));

    if (offset < min) {
      min = offset;
      closest = i;
    }
  });

  cards.forEach(c => c.classList.remove("active"));
  cards[closest].classList.add("active");

  const realIndex = closest % total;
  dots.forEach(d => d.classList.remove("active"));
  dots[realIndex].classList.add("active");

  /* LOOP */
  if (closest >= total) {
    slider.scrollLeft -= track.scrollWidth / 2;
    index = closest - total;
  }
};

/* AUTOPLAY */
const autoplay = () => {
  if (isHovering) return;
  index++;
  scrollToCard(index);
};

slider.addEventListener("mouseenter", () => isHovering = true);
slider.addEventListener("mouseleave", () => isHovering = false);
slider.addEventListener("scroll", update);

window.addEventListener("load", () => {
  scrollToCard(index);
  update();
  setInterval(autoplay, 3500);
});
</script>