<section class="services" id="servicios">
  <div class="container">
    <div class="header">
      <h2>Nuestros servicios</h2>
      <p>Soluciones logísticas diseñadas para que tu operación nunca se detenga.</p>
    </div>

    <div class="carousel">
      <button class="nav prev">‹</button>

      <div class="viewport">
        <div class="track" id="track">

          <!-- CARDS -->
          <div class="card">
            <img src="/entregas.jpeg" />
            <div class="content">
              <h3>Transporte de carga</h3>
              <p>Movilizamos tu carga con puntualidad, seguridad y trazabilida en todo momento.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>

          <div class="card">
            <img src="/almacenamiento.jpg" />
            <div class="content">
              <h3>Almacenamiento</h3>
              <p>Más de 10.000 m² disponibles para tus operaciones.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>

          <div class="card">
            <img src="/retiros.jpg" />
            <div class="content">
              <h3>Retiros y entregas en puerto</h3>
              <p>Operación fluida, coordinada eficientemente y sin demoras.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>

          <div class="card">
            <img src="/desconsolidado.jpeg" />
            <div class="content">
              <h3>Desconsolidado/Consolidado</h3>
              <p>Contamos con un equipo especializado en todo tipo de desconsolidado de carga.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>

          <div class="card">
            <img src="/vacios.jpg" />
            <div class="content">
              <h3>Entrega/Devolución de Vacíos</h3>
              <p>Gestión eficiente de retiro y devolución de contenedores vacíos.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>

          <div class="card">
            <img src="/Reefer.png" />
            <div class="content">
              <h3>Operaciones Reefer</h3>
              <p>Contamos con equipos especializados en el manejo de carga refrigerada.</p>
              <a href="/#cotizar" class="cta">Cotizar →</a>
            </div>
          </div>
        </div>
      </div>
      <button class="nav next">›</button>
    </div>

    <div class="dots" id="dots"></div>
  </div>
</section>

<style is:global>
#servicios {
  scroll-margin-top: 40px;
}

.services {
  padding: 5rem 2rem;
  background: radial-gradient(circle at 50% 0%, #1e293b, #020617);
  font-family: "Montserrat", sans-serif;
}

.container {
  max-width: 1200px;
  height: 100%;
  margin: auto;
}

.header {
  text-align: center;
  margin-bottom: 60px;
}

.header h2 {
  color: white;
  font-size: 1.9rem;
}

.header p {
  color: #94a3b8;
}

/* CAROUSEL */
.carousel {
  position: relative;
}

.viewport {
  overflow: hidden;
  width: 100%;
  position: relative;
}

/* efecto fade lateral */
.viewport::before,
.viewport::after {
  content: "";
  position: absolute;
  top: 0;
  width: 120px;
  height: 100%;
  z-index: 5;
  pointer-events: none;
}
/* TRACK */
.track {
  display: flex;
  gap: 30px;
  transition: transform .7s cubic-bezier(.22,1,.36,1);
  will-change: transform;
}

/* CARD */
.card {
  width: 300px;
  flex: 0 0 auto;
  overflow: hidden;
  background: #fff;
  transform: scale(.7);
  opacity: .15;
  filter: blur(6px);

  transition: 
    transform .6s cubic-bezier(.22,1,.36,1),
    opacity .5s ease,
    filter .5s ease;

    h3{
      font-size: 0.9rem;
      margin-bottom: 10px;
    }
    p{
      font-size: 0.75rem;
      color: #555;
    }
    a{
      font-size: 0.8rem;
    }
}

.card.active {
  transform: scale(1);
  opacity: 1;
  filter: blur(0);
  z-index: 3;

  box-shadow:
    0 40px 120px rgba(0,0,0,.6),
    0 0 0 1px rgba(255,255,255,.05);
}

.card.prev,
.card.next {
  transform: scale(.9);
  opacity: .4;
  filter: blur(2px);
  z-index: 2;
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.content {
  padding: 20px;
}

.cta {
  display: block;
  margin-top: 15px;
  padding: 10px;
  background: black;
  color: white;
  text-align: center;
  border-radius: 6px;
  text-decoration: none;
}

/* NAV */
.nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.75);
  color: #111;
  cursor: pointer;
  z-index: 10;
}

.prev { left: -15px; }
.next { right: -15px; }

/* DOTS */
.dots {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 20px;
}

.dot {
  width: 8px;
  height: 8px;
  background: #555;
  border-radius: 50%;
  cursor: pointer;
}

.dot.active {
  width: 25px;
  background: white;
}
</style>

<script client:load>
const track = document.getElementById("track");
const viewport = document.querySelector(".viewport");
const dotsContainer = document.getElementById("dots");

let cards = Array.from(track.children);
let index = 0;
let autoplay;
let userInteracted = false;

const gap = 30;

/* CLONES */
track.appendChild(cards[0].cloneNode(true));
track.insertBefore(cards[cards.length - 1].cloneNode(true), cards[0]);

const allCards = () => track.querySelectorAll(".card");

/* 🔥 CENTRADO PERFECTO */
function move() {
  const card = allCards()[index + 1];
  if (!card) return;

  const viewportCenter = viewport.offsetWidth / 2;
  const cardCenter = card.offsetLeft + card.offsetWidth / 2;

  const offset = cardCenter - viewportCenter;

  track.style.transform = `translateX(-${offset}px)`;

  update();
}

/* UI */
function update() {
  allCards().forEach(c => c.classList.remove("active","prev","next"));

  allCards()[index + 1]?.classList.add("active");
  allCards()[index]?.classList.add("prev");
  allCards()[index + 2]?.classList.add("next");

  dots.forEach(d => d.classList.remove("active"));
  dots[index]?.classList.add("active");
}

/* LOOP */
track.addEventListener("transitionend", () => {
  if (index >= cards.length) {
    track.style.transition = "none";
    index = 0;
    move();
  }

  if (index < 0) {
    track.style.transition = "none";
    index = cards.length - 1;
    move();
  }

  requestAnimationFrame(() => {
    track.style.transition = "transform .7s cubic-bezier(.22,1,.36,1)";
  });
});

/* DOTS */
cards.forEach((_, i) => {
  const dot = document.createElement("div");
  dot.classList.add("dot");
  dotsContainer.appendChild(dot);

  dot.onclick = () => {
    index = i;
    move();
    stop();
  };
});

const dots = dotsContainer.querySelectorAll(".dot");

/* NAV */
document.querySelector(".next").onclick = () => {
  index++;
  move();
  stop();
};

document.querySelector(".prev").onclick = () => {
  index--;
  move();
  stop();
};

/* AUTOPLAY */
function start() {
  autoplay = setInterval(() => {
    if (userInteracted) return;
    index++;
    move();
  }, 3500);
}

function stop() {
  userInteracted = true;
  clearInterval(autoplay);
}

/* DRAG */
let startX = 0;
let dragging = false;

track.addEventListener("pointerdown", e => {
  dragging = true;
  startX = e.clientX;
  stop();
});

window.addEventListener("pointerup", e => {
  if (!dragging) return;
  dragging = false;

  const diff = e.clientX - startX;

  if (diff > 50) index--;
  else if (diff < -50) index++;

  move();
});

/* INIT */
window.addEventListener("load", () => {
  move();
  start();
});
</script>