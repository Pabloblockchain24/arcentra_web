<section id="cotizar" class="contact">
  <div class="container">

    <div class="header">
      <h2 class="header-cta">Solicita tu transporte</h2>
      <p>Cuéntanos tu necesidad y te responderemos a la brevedad</p>
    </div>

    <div class="grid">

      <!-- FORMULARIO -->
      <form class="form" id="contactForm">
        <input type="text" name="nombre" placeholder="Nombre" required />
        <input type="email" name="email" placeholder="Email" required />
        <input type="text" name="telefono" placeholder="Teléfono" />
        <textarea name="descripcion" placeholder="Detalles del servicio" rows="4"></textarea>

        <button type="submit" id="submitBtn">Enviar solicitud</button>

        <!-- Mensaje -->
        <p id="formMessage" class="form-message"></p>
      </form>

      <!-- CONTACTO DIRECTO -->
      <div class="info">
        <h3>Contacto directo</h3>

        <a href="https://wa.me/56950727028" target="_blank" class="whatsapp">
          💬 WhatsApp
        </a>

        <p>📞 +56 9 5072 7028</p>
        <p>✉️ pabloarce@arcentra.cl</p>
      </div>

    </div>

  </div>
</section>

<style>
  #cotizar {
    scroll-margin-top: 60px;
  }

  .contact {
    padding: 80px 20px;
    background: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 50px;
  }

  .header-cta {
    font-size: 1.9rem;
    margin-bottom: 10px;
    color: #111;
  }

  .header p {
    color: #555;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  /* FORM */
  .form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .form input,
  .form textarea {
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: 'Montserrat', sans-serif;
  }

  .form button {
    background: #444;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .form button:hover {
    background: #111;
  }

  .form button:disabled {
    background: #999;
    cursor: not-allowed;
  }

  /* MENSAJE */
  .form-message {
    font-size: 0.9rem;
    min-height: 18px;
  }

  .form-message.success {
    color: #16a34a;
  }

  .form-message.error {
    color: #dc2626;
  }

  /* INFO */
  .info {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .info h3 {
    margin-bottom: 10px;
  }

  .whatsapp {
    background: #25d365b6;
    color: white;
    padding: 10px 15px;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    display: inline-block;
  }

  .whatsapp:hover {
    background: #25d365;
  }

  /* 📱 Responsive */
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .header p {
      font-size: 0.9rem;
    }

    .form input {
      font-size: 0.85rem;
    }

    .info a, .info p {
      font-size: 0.9rem;
    } 
  }
</style>

<script client:load>
  const form = document.getElementById("contactForm");
  const button = document.getElementById("submitBtn");
  const message = document.getElementById("formMessage");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Estado loading
    button.disabled = true;
    button.textContent = "Enviando...";
    message.textContent = "";
    message.className = "form-message";

    const data = {
      nombre: form.nombre.value,
      email: form.email.value,
      telefono: form.telefono.value,
      descripcion: form.descripcion.value,
    };

    try {
      const res = await fetch("https://arcentra-back.vercel.app/api/send-mail", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        message.textContent = "✅ Solicitud enviada correctamente. Te contactaremos pronto.";
        message.classList.add("success");
        form.reset();
      } else {
        message.textContent = "❌ No pudimos enviar tu solicitud. Por favor, escríbenos al WhatsApp.";
        message.classList.add("error");
      }

    } catch (error) {
      console.error(error);
      message.textContent = "❌ Error de conexión. Intenta más tarde.";
      message.classList.add("error");
    }

    // Restaurar botón
    button.disabled = false;
    button.textContent = "Enviar solicitud";
  });
</script>